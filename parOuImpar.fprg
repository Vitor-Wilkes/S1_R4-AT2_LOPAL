    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="valor, resul, desc" type="Real" array="False" size=""/>
            <output expression="&quot;Digite a sua altura(em metros):&quot;" newline="True"/>
            <input variable="valor"/>
            <if expression="valor &gt;= 1.4">
                <then>
                    <output expression="&quot;Pode entrar no brinquedo.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Altura insuficiente.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
