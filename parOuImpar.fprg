    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="number, resul" type="Integer" array="False" size=""/>
            <output expression="&quot;Informe o n&#250;mero:&quot;" newline="True"/>
            <input variable="number"/>
            <assign variable="resul" expression="number % 2"/>
            <if expression="resul = 0">
                <then>
                    <output expression="&quot;Seu n&#250;mero &#233; par.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Seu n&#250;mero &#233; &#237;mpar.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
