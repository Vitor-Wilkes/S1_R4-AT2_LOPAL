        <attribute name="edited" value="STFIU0E7RUNGUDUxMk4xMjYyODQ2OzIwMjYtMDQtMTM7IjA5OjU2OjAyICI7MzsyNTI4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="valor, resul, desc" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o valor da sua compra:&quot;" newline="True"/>
            <input variable="valor"/>
            <if expression="valor &gt;= 150">
                <then>
                    <assign variable="resul" expression="valor - (valor * 0.02)"/>
                    <assign variable="desc" expression="valor * 0.02"/>
                    <output expression="&quot;O seu desconto foi de &quot; &amp; desc &amp; &quot; reais, sendo o valor total &quot; &amp; resul &amp; &quot; reais.&quot;" newline="True"/>
                </then>
                <else>
                    <assign variable="desc" expression="valor * 0.02"/>
                    <output expression="&quot;O seu cashback foi de &quot; &amp; desc &amp; &quot; reais, sendo o valor total &quot; &amp; valor &amp; &quot; reais.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
