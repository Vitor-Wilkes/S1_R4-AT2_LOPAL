    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="senha, senha2" type="String" array="False" size=""/>
            <output expression="&quot;Digite a senha:&quot;" newline="True"/>
            <input variable="senha"/>
            <output expression="&quot;Digite novamente a senha:&quot;" newline="True"/>
            <if expression="senha == senha2">
                <then>
                    <output expression="&quot;Acesso permitido&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Acesso negado.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
